{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/shared/ipc.ts",
    "src/shared/clickThrough.ts",
    "src/shared/placement.ts",
    "src/shared/ambientMotion.ts",
    "src/shared/robotFrame.ts",
    "src/shared/behavior.ts",
    "src/shared/gaze.ts",
    "src/shared/presentation.ts"
  ]
}
